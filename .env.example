# Copy this file to .env and fill in your local MySQL credentials.
# .env is git-ignored so each teammate keeps their own values.

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_NAME=barangay_crime_db

# Express
PORT=4000

# Rows generated by `npm run db:seed`
SEED_INCIDENT_COUNT=1000
SEED_MONTHS=24
SEED_END_MONTH=2026-07
